# invest_wiki .gitignore

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# Backups
*.bak
*.backup

# IDE
.vscode/
.idea/

# AuraKit session data (regenerated per session)
.aura/logs/
.aura/agent-memory/
.aura/governance/
.aura/instincts/
.aura/snapshots/

# Secrets
.env
.env.*

# Attachments — track text backups + downloaded images, exclude PDF/docx binaries
L0-原始资料池/_attachments/*.pdf
L0-原始资料池/_attachments/*.docx

# Temporary working files
*_content.json
!L0-原始资料池/**/*.json
